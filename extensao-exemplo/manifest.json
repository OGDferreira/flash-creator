{
  "manifest_version": 3,
  "name": "Flash Creator — Códigos Gmail",
  "version": "1.0.0",
  "description": "Recebe os Gmails disponíveis e os códigos do app Flash Creator (servidor local).",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1:8777/*", "http://localhost:8777/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Flash Creator", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}

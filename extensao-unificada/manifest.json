{
  "manifest_version": 3,
  "name": "extensionsIG.avl",
  "version": "1.64",
  "description": "v1.64: sem API de Gmail (e-mail/código digitados na tela); conta suspensa desloga (apaga cookies) e recomeça o cadastro.",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://flashpost.onrender.com/*",
    "http://flashpost.onrender.com/*",
    "https://ebooksucessodigital.online/*",
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*"
  ],
  "action": {
    "default_title": "extensionsIG.avl",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "instagram-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "auto-fluxo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "unified-orchestrator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-photo-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-profile-edit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flashpost.onrender.com/*",
        "http://flashpost.onrender.com/*"
      ],
      "js": [
        "flow-login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ebooksucessodigital.online/*"
      ],
      "js": [
        "story-flow-login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

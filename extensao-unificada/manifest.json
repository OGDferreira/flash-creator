{
  "manifest_version": 3,
  "name": "extensionsIG.avl",
  "version": "1.70",
  "description": "v1.70: Flashpost NÃO abre mais sozinho (nem pós-cadastro nem pós-conversão); só abre no clique do botão 🔗 Flashpost — fim do monte de guias. Mantém: +<aleatório> no e-mail antes de enviar; extensão única com destaque embutido travado no perfil pós-conexão; Flashpost conecta 1x por conta; botões sem sobreposição; sem API de Gmail; suspenso desloga e recomeça.",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://flashpost.onrender.com/*",
    "http://flashpost.onrender.com/*",
    "https://ebooksucessodigital.online/*",
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*"
  ],
  "action": {
    "default_title": "extensionsIG.avl",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "instagram-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "auto-fluxo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "unified-orchestrator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "destaque.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-photo-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-profile-edit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flashpost.onrender.com/*",
        "http://flashpost.onrender.com/*"
      ],
      "js": [
        "flow-login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ebooksucessodigital.online/*"
      ],
      "js": [
        "story-flow-login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

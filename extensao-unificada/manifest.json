{
  "manifest_version": 3,
  "name": "extensionsIG.avl",
  "version": "1.74",
  "description": "v1.74: sem pop-up — você digita/cola o e-mail no campo do Instagram e a extensão só acrescenta o +número (máx 3 díg.) antes de enviar. Botão Flashpost mais rápido: abre a guia, login, Conectar conta e Permitir, só isso (delays reduzidos). Mantém: auto-config 1x por conta sem loop pós-Flashpost; zoom 50%; conecta 1x; destaque pós-conexão; botões sem sobreposição.",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://flashpost.onrender.com/*",
    "http://flashpost.onrender.com/*",
    "https://ebooksucessodigital.online/*",
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*"
  ],
  "action": {
    "default_title": "extensionsIG.avl",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "instagram-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "auto-fluxo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "unified-orchestrator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "destaque.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-photo-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-profile-edit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flashpost.onrender.com/*",
        "http://flashpost.onrender.com/*"
      ],
      "js": [
        "flow-login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ebooksucessodigital.online/*"
      ],
      "js": [
        "story-flow-login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
